  <!-- ==========================================================================
       APPLICATION SCRIPT & LOGIC
       ========================================================================== -->
  <script>
    // State
    let currentRole = 'user';
    let shredderRpm = 1800;

    // Charts Initializer
    document.addEventListener('DOMContentLoaded', () => {
      initCharts();
    });

    // Portal Switcher
    function switchPortal(role) {
      currentRole = role;
      document.getElementById('roleBtnUser').classList.toggle('active', role === 'user');
      document.getElementById('roleBtnAdmin').classList.toggle('active', role === 'admin');
      
      const title = document.getElementById('authPortalTitle');
      const sub = document.getElementById('authPortalSubtitle');
      
      if (role === 'admin') {
        title.textContent = 'Admin Control Center';
        sub.textContent = 'Facility management & processing command';
      } else {
        title.textContent = 'Welcome Back';
        sub.textContent = 'Sign in to access your sustainability dashboard';
      }
    }

    function switchAuthTab(tab) {
      document.getElementById('tabBtnLogin').classList.toggle('active', tab === 'login');
      document.getElementById('tabBtnSignup').classList.toggle('active', tab === 'signup');
      document.getElementById('loginFormContainer').style.display = tab === 'login' ? 'block' : 'none';
      document.getElementById('signupFormContainer').style.display = tab === 'signup' ? 'block' : 'none';
    }

    function quickFill(role) {
      switchPortal(role);
      if (role === 'admin') {
        document.getElementById('loginEmail').value = 'admin@sanjaytextiles.com';
      } else {
        document.getElementById('loginEmail').value = 'sophia@example.com';
      }
      document.getElementById('loginPassword').value = 'password123';
    }

    function handleLogin(e) {
      e.preventDefault();
      document.getElementById('authWrapper').style.display = 'none';
      
      if (currentRole === 'admin') {
        document.getElementById('adminDashboardLayout').style.display = 'grid';
        showToast('Welcome Administrator!');
      } else {
        document.getElementById('userDashboardLayout').style.display = 'grid';
        showToast('Welcome back, Sophia Carter!');
      }
    }

    function handleSignup(e) {
      e.preventDefault();
      showToast('Account registered! 100 bonus points added.');
      switchAuthTab('login');
    }

    function logout() {
      document.getElementById('userDashboardLayout').style.display = 'none';
      document.getElementById('adminDashboardLayout').style.display = 'none';
      document.getElementById('authWrapper').style.display = 'grid';
      showToast('Logged out successfully.');
    }

    // Navigation Switches
    function switchTab(e, tabId) {
      e.preventDefault();
      document.querySelectorAll('#userDashboardLayout .nav-item').forEach(el => el.classList.remove('active'));
      e.currentTarget.classList.add('active');

      document.querySelectorAll('#userDashboardLayout .tab-content').forEach(el => el.classList.remove('active'));
      document.getElementById(tabId).classList.add('active');
    }

    function triggerNavTab(tabId) {
      const link = document.querySelector(`#userDashboardLayout .nav-item[onclick*="${tabId}"]`);
      if (link) link.click();
    }

    function switchAdminTab(e, tabId) {
      e.preventDefault();
      document.querySelectorAll('#adminDashboardLayout .nav-item').forEach(el => el.classList.remove('active'));
      e.currentTarget.classList.add('active');

      document.querySelectorAll('#adminDashboardLayout .tab-content').forEach(el => el.classList.remove('active'));
      document.getElementById(tabId).classList.add('active');
    }

    // Theme Toggle
    function toggleTheme() {
      const current = document.documentElement.getAttribute('data-theme');
      const next = current === 'light' ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', next);
      showToast(`Switched to ${next} theme`);
    }

    function toggleNotifPopover() {
      document.getElementById('userNotifPopover').classList.toggle('show');
    }

    // Interactive Logic
    function selectFabric(el) {
      document.querySelectorAll('.fabric-type-box').forEach(b => b.classList.remove('selected'));
      el.classList.add('selected');
    }

    function calcReward() {
      const w = parseFloat(document.getElementById('pickupWeight').value) || 0;
      document.getElementById('calcPoints').textContent = `+${Math.round(w * 10)} Eco Pts`;
      document.getElementById('calcCo2').textContent = `${(w * 2.7).toFixed(1)} kg CO₂ Offset`;
    }

    function handlePickupSubmit(e) {
      e.preventDefault();
      showToast('Pickup request #PK-1091 submitted!');
      triggerNavTab('tabUserOverview');
    }

    function runAiScan(sample) {
      const box = document.getElementById('aiScannerBox');
      box.classList.add('scanning');

      setTimeout(() => {
        box.classList.remove('scanning');
        document.getElementById('aiPlaceholder').style.display = 'none';
        document.getElementById('aiResultBox').style.display = 'block';

        if (sample === 'Organic Cotton') {
          document.getElementById('aiResultTitle').textContent = 'Organic Cotton Offcuts';
          document.getElementById('aiResultComp').textContent = '100% Pure Organic Cotton';
          document.getElementById('aiResultScore').textContent = '98% High Recyclability';
        } else if (sample === 'Polyester Blend') {
          document.getElementById('aiResultTitle').textContent = 'Polyester Sportswear';
          document.getElementById('aiResultComp').textContent = '85% Polyester, 15% Elastane';
          document.getElementById('aiResultScore').textContent = '76% Medium (Chemical Stream)';
        } else {
          document.getElementById('aiResultTitle').textContent = 'Pre-loved Denim Twill';
          document.getElementById('aiResultComp').textContent = '98% Cotton, 2% Elastane';
          document.getElementById('aiResultScore').textContent = '94% High Recyclability';
        }

        showToast('AI Fiber Analysis Complete');
      }, 1200);
    }

    function adjustShredder(delta) {
      shredderRpm += delta;
      document.getElementById('shredderRpmText').textContent = `${shredderRpm} RPM`;
      showToast(`Shredder RPM adjusted to ${shredderRpm}`);
    }

    // Modals & Toasts
    function openQrModal(id) {
      document.getElementById('qrCodeText').textContent = `ST-${id}-2026`;
      document.getElementById('qrModal').classList.add('show');
    }

    function closeQrModal() {
      document.getElementById('qrModal').classList.remove('show');
    }

    function showToast(msg) {
      const container = document.getElementById('toastContainer');
      const toast = document.createElement('div');
      toast.className = 'toast';
      toast.innerHTML = `✨ <strong>System:</strong> ${msg}`;
      container.appendChild(toast);
      setTimeout(() => toast.remove(), 3500);
    }

    // Charts Config
    function initCharts() {
      // User Fabric Doughnut
      const ctxUser = document.getElementById('userFabricChart');
      if (ctxUser) {
        new Chart(ctxUser, {
          type: 'doughnut',
          data: {
            labels: ['Cotton', 'Denim', 'Polyester', 'Silk/Wool'],
            datasets: [{
              data: [55, 25, 12, 8],
              backgroundColor: ['#10b981', '#06b6d4', '#6366f1', '#f59e0b'],
              borderWidth: 0
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { position: 'right', labels: { color: '#94a3b8' } } }
          }
        });
      }

      // Admin Monthly Bar
      const ctxBar = document.getElementById('adminMonthlyChart');
      if (ctxBar) {
        new Chart(ctxBar, {
          type: 'bar',
          data: {
            labels: ['May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct'],
            datasets: [{
              label: 'Collected (Tons)',
              data: [38, 42, 45, 50, 54, 58],
              backgroundColor: '#6366f1',
              borderRadius: 6
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
              x: { ticks: { color: '#94a3b8' }, grid: { display: false } },
              y: { ticks: { color: '#94a3b8' }, grid: { color: 'rgba(255,255,255,0.05)' } }
            }
          }
        });
      }

      // Admin Stream Pie
      const ctxStream = document.getElementById('adminStreamChart');
      if (ctxStream) {
        new Chart(ctxStream, {
          type: 'pie',
          data: {
            labels: ['Shredded Fiber', 'Charity Upcycle', 'Chemical Recovery'],
            datasets: [{
              data: [50, 30, 20],
              backgroundColor: ['#10b981', '#3b82f6', '#f59e0b'],
              borderWidth: 0
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { position: 'right', labels: { color: '#94a3b8' } } }
          }
        });
      }
    }
  </script>
</body>

